# Public URL without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep "demo" while auth, preferences, and notifications use cookie storage.
FAIRPRICE_DEPLOYMENT_MODE=demo
FAIRPRICE_ADMIN_EMAIL=admin@fairprice.local
FAIRPRICE_ADMIN_PASSWORD=change-this-local-admin-password
FAIRPRICE_AUTH_SECRET=change-this-local-auth-secret-at-least-32-characters
FAIRPRICE_OPERATOR_NAME=Fairprice 운영자
FAIRPRICE_CONTACT_EMAIL=contact@example.com

# Local Postgres / Prisma
DATABASE_URL="postgresql://fairprice:fairprice_local_dev@localhost:5432/fairprice?schema=public"
DIRECT_URL="postgresql://fairprice:fairprice_local_dev@localhost:5432/fairprice?schema=public"

# Email notifications. Resend sender must be a verified domain/address.
RESEND_API_KEY=
EMAIL_FROM=Fairprice <alerts@example.com>

# Coupang Partners API.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_SUB_ID=
COUPANG_COLLECTION_KEYWORDS="물티슈,커피,무선이어폰"

# Protects /api/cron/* routes.
CRON_SECRET=change-this-local-cron-secret-at-least-32-characters
ALERT_COOLDOWN_HOURS=24

# Optional search console verification tokens.
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Google AdSense publisher ID. Accepts pub-... or ca-pub-....
GOOGLE_ADSENSE_PUBLISHER_ID=
