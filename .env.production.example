NEXT_PUBLIC_APP_URL=https://your-domain.com
FAIRPRICE_DEPLOYMENT_MODE=production

DATABASE_URL=postgresql://fairprice_user:change_this_password@127.0.0.1:5432/fairprice

FAIRPRICE_ADMIN_EMAIL=admin@your-domain.com
FAIRPRICE_ADMIN_PASSWORD=replace-with-a-long-production-password
FAIRPRICE_AUTH_SECRET=replace-with-a-long-random-session-secret
FAIRPRICE_OPERATOR_NAME=replace-with-operator-or-company-name
FAIRPRICE_CONTACT_EMAIL=contact@your-domain.com
CRON_SECRET=replace-with-a-long-random-cron-secret
ALERT_COOLDOWN_HOURS=24

COUPANG_PARTNERS_ACCESS_KEY=replace-with-coupang-access-key
COUPANG_PARTNERS_SECRET_KEY=replace-with-coupang-secret-key
COUPANG_PARTNERS_SUB_ID=fairprice
COUPANG_COLLECTION_KEYWORDS=물티슈,커피,무선이어폰

RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Fairprice <deals@your-domain.com>

NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
GOOGLE_ADSENSE_PUBLISHER_ID=pub-replace-with-your-publisher-id
