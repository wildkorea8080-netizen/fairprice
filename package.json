{
  "name": "fairprice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "npm run db:deploy && next start",
    "lint": "eslint",
    "check:env": "node scripts/check-production-env.mjs",
    "email:check": "node scripts/check-email-config.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "readiness:check": "node scripts/check-readiness.mjs",
    "secrets:generate": "node scripts/generate-production-secrets.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:deal-score": "node --no-warnings --experimental-strip-types scripts/test-deal-score.mjs",
    "test:deal-detection": "node --no-warnings --experimental-strip-types scripts/test-deal-detection.mjs",
    "test:units": "node --no-warnings --experimental-strip-types scripts/test-unit-normalizer.mjs",
    "test:title-similarity": "node --no-warnings --experimental-strip-types scripts/test-title-similarity.mjs",
    "test:diverse-products": "node --no-warnings --experimental-strip-types scripts/test-diverse-products.mjs",
    "test:collection-job-selection": "node --no-warnings --experimental-strip-types scripts/test-collection-job-selection.mjs",
    "test:adsense": "node --no-warnings --experimental-strip-types scripts/test-adsense.mjs",
    "test:data-confidence": "node --no-warnings --experimental-strip-types scripts/test-data-confidence.mjs",
    "test:tracking-priority": "node --no-warnings --experimental-strip-types scripts/test-tracking-priority.mjs",
    "test:deal-engine": "npm run test:deal-score && npm run test:deal-detection",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "cron:pipeline": "node scripts/run-cron-pipeline.mjs --batchSize=5 --clickKeywordLimit=10 --sendDryRun=false",
    "cron:alerts": "node scripts/run-cron-pipeline.mjs --steps=alerts,send --sendDryRun=true",
    "cron:collect": "node scripts/run-cron-pipeline.mjs --steps=collect --batchSize=5",
    "cron:discover": "node scripts/run-cron-pipeline.mjs --steps=discover,click-keywords --clickKeywordLimit=10",
    "cron:clicks": "node scripts/run-cron-pipeline.mjs --steps=click-keywords --clickKeywordLimit=10",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:check": "node scripts/check-db.mjs",
    "db:verify-catalog": "node scripts/verify-catalog-migration.mjs",
    "db:backfill-units": "node --no-warnings --experimental-strip-types scripts/backfill-product-units.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
